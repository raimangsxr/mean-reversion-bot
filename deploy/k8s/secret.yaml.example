apiVersion: v1
kind: Secret
metadata:
  name: mean-reversion-bot-secrets
  namespace: mean-reversion-bot
type: Opaque
stringData:
  # Binance USD-M Demo credentials. Copy this file to secret.yaml and replace
  # both values. secret.yaml is ignored by Git.
  BINANCE_API_KEY: "replace-me"
  BINANCE_SECRET_KEY: "replace-me"
