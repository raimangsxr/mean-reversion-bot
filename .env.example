# =============================================================================
# Binance Demo / live - V10.2 codebase
# =============================================================================
BINANCE_API_KEY=xxx
BINANCE_SECRET_KEY=yyy
USE_TESTNET=True

LIVE_SYMBOLS=BTC/USDT:USDT
LIVE_MAX_CONCURRENT_POSITIONS=3
ENABLE_LONGS=True
ENABLE_SHORTS=False

TIMEFRAME=1h
MARGIN_MODE=isolated
LEVERAGE=2
TRIGGER_PRICE_TYPE=MARK_PRICE

# Live trigger remains the proven confirmed z-score path.
LOOKBACK_WINDOW=20
Z_THRESHOLD=2.2
ENTRY_MODE=confirmed
REGIME_MODE=1h_sma200_4h_ema200
REGIME_TIMEFRAME=4h
REGIME_EMA_WINDOW=200
ATR_MULTIPLIER=1.5

ENTRY_EXECUTION_MODE=pullback_limit
ENTRY_LIMIT_OFFSET_BPS=3.0
ENTRY_LIMIT_WAIT_SECONDS=420
ENTRY_FALLBACK_CAP_BPS=5.0
ENTRY_PENDING_POLL_SECONDS=10
ENTRY_FALLBACK_MAX_LATENESS_SECONDS=60

EXIT_MODE=fixed_rr
RISK_REWARD_RATIO=1.8
TAKE_PROFIT_ORDER_MODE=maker_limit

INITIAL_CAPITAL=10000
RISK_PER_TRADE=0.005
MAX_POSITION_PCT=0.30
CASH_BUFFER_PCT=0.05
MAX_PORTFOLIO_RISK_PCT=0.01

STATE_FILE=state/testnet_bot_state.json
EXECUTION_JOURNAL_FILE=state/testnet_execution_journal.jsonl

CANDLE_CLOSE_DELAY_SECONDS=2
SIGNAL_MAX_AGE_SECONDS=60
ERROR_RETRY_SECONDS=10
POSITION_POLL_SECONDS=30

# =============================================================================
# V10.2 research
# =============================================================================
BACKTEST_START=2020-01-01T00:00:00Z
# BACKTEST_END omitted => current UTC at process start.
BACKTEST_SYMBOLS=BTC/USDT:USDT

BACKTEST_TAKER_FEE=0.0005
BACKTEST_MAKER_FEE=0.0002
BACKTEST_MARKET_SLIPPAGE_BPS=1,2,3,5
BACKTEST_PRIMARY_SLIPPAGE_BPS=2
BACKTEST_TP_CROSS_TICKS=1
BACKTEST_REQUIRE_FUNDING=True
BACKTEST_FUNDING_CACHE_DIR=state/funding
BACKTEST_MINUTE_CACHE_DIR=state/minute
BACKTEST_HISTORY_CACHE_DIR=state/history
BACKTEST_MAX_PORTFOLIO_RISK_PCT=0.015
BACKTEST_MAX_CONCURRENT_POSITIONS=3
BACKTEST_DD_LIMIT=0.10
BACKTEST_MIN_TRAIN_TRADES=60
BACKTEST_FIRST_TEST_YEAR=2022
BACKTEST_PARTIAL_FRACTION=0.50

BACKTEST_FEE_STRESS_MULTIPLIERS=1.0,1.2
BACKTEST_FUNDING_STRESS_MULTIPLIERS=1.0,1.5,2.0

# Confirmations frozen before the V10.2 run; no threshold tuning occurs here.
V10_2_SHOCK1H_THRESHOLD=2.175
V10_2_SHOCK3H_THRESHOLD=1.725
V10_2_VWAP48H_THRESHOLD=1.55
V10_2_TAKER_MIN_SHOCK_ATR=0.925
V10_2_RETURN_SHOCK_VOL_WINDOW=100
V10_2_TAKER_LOOKBACK=100
V10_2_TAKER_SELL_QUANTILE=0.90
V10_2_TAKER_CACHE_DIR=state/taker
V10_2_DEVELOPMENT_START_YEAR=2022

# Sizing study applies only to z-score + shock1h.
V10_2_RISK_GRID=0.005,0.0075,0.01,0.015
V10_2_MAX_POSITION_GRID=0.30,0.50,0.70,1.00
V10_2_SIZING_DD_LIMIT=0.10
V10_2_SIZING_MIN_PF=1.20

# Funding snapshot continuity / cleanup.
V10_2_FUNDING_MAX_GAP_HOURS=12
V10_2_CLEAN_OLD_ARTIFACTS=True

# Outputs: only V10.2 research artifacts.
V10_2_SUMMARY_FILE=state/backtest_v10_2_summary.csv
V10_2_ANNUAL_FILE=state/backtest_v10_2_annual.csv
V10_2_OPPORTUNITIES_FILE=state/backtest_v10_2_opportunities.csv
V10_2_SIZING_FILE=state/backtest_v10_2_sizing.csv
V10_2_SENSITIVITY_FILE=state/backtest_v10_2_sensitivity.csv
V10_2_STRESS_FILE=state/backtest_v10_2_stress.csv
V10_2_RECOMMENDATION_FILE=state/backtest_v10_2_recommendation.json
